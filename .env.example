# Production: copy to .env beside compose.yaml and fill in (docs/deployment.md).
THROW_IMAGE=ghcr.io/iiloni/throw:stable
# Before the first release, or to build a checkout, uncomment instead:
# COMPOSE_FILE=docker-compose.yml:docker-compose.build.yml
BETTER_AUTH_URL=https://throw.example.com
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
POSTGRES_PASSWORD=change-me
ELECTRIC_SECRET=change-me
# The first account becomes admin. Later signups need an invite by default.
# Use closed to refuse all later signups or open for unrestricted registration.
# REGISTRATION=invite
# The reverse proxy in front of Throw, as IP addresses or CIDR ranges, comma separated. Its
# X-Forwarded-For is then believed for the sign-in rate limit. From a proxy on the Docker
# host, connections arrive from the Compose network's gateway (docker network inspect).
# List that one address rather than a range: anything in it can pick its own rate limit.
# TRUSTED_PROXIES=172.18.0.1
# Webhooks reach only public HTTPS receivers unless you trust private ones here, such as a
# tailnet's MagicDNS names and addresses (docs/deployment.md#webhooks).
# WEBHOOK_ALLOWED_HOSTS=*.example-tailnet.ts.net
# WEBHOOK_ALLOWED_CIDRS=100.64.0.0/10,fd7a:115c:a1e0::/48
# THROW_PORT=3100
THROW_BIND_ADDRESS=127.0.0.1

# Development: worktree stacks generate their own settings in .env.worktree
# (see WORKTREES.md). Values here in the primary checkout's .env are shared by
# every worktree stack, which is where future API keys belong.

# Server backups (docs/backups.md)
# THROW_BACKUPS_MOUNT=/mnt/backups/throw
UPDATE_BACKUPS=true
UPDATE_BACKUPS_KEPT=10
