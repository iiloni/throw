<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- The installed channel's own icon names the app outside the launcher (app info,
         recents); the launcher shows whichever icon the switcher chose. -->
    <application
        android:icon="@mipmap/ic_launcher_dev"
        android:roundIcon="@mipmap/ic_launcher_dev"
        tools:replace="android:icon,android:roundIcon" />
</manifest>
