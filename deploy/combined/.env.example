COMPOSE_PROFILES=catch,throw
CATCH_IMAGE=ghcr.io/iiloni/catch:stable
THROW_IMAGE=ghcr.io/iiloni/throw:stable
# Generate each credential independently with openssl rand -hex 32.
POSTGRES_PASSWORD=
CATCH_DATABASE_PASSWORD=
THROW_DATABASE_PASSWORD=
CATCH_AUTH_SECRET=
THROW_AUTH_SECRET=
CATCH_ELECTRIC_SECRET=
THROW_ELECTRIC_SECRET=
CATCH_URL=https://notes.example.com
THROW_URL=https://tasks.example.com
BIND_ADDRESS=127.0.0.1
CATCH_PORT=3000
THROW_PORT=3100
TRUSTED_PROXIES=
# Optional writable directories on another disk (container UID 1000):
# CATCH_BACKUPS_MOUNT=/mnt/backups/catch
# THROW_BACKUPS_MOUNT=/mnt/backups/throw
